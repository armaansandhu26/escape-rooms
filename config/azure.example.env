# Copy to .env in the repo root (gitignored) and fill in your key.
# Do not commit real secrets.

AZURE_OPENAI_API_KEY=your-foundry-or-azure-openai-key

# v1 base URL ( /responses is appended by the SDK )
AZURE_OPENAI_BASE_URL=https://armaan-foundry.services.ai.azure.com/openai/v1/

# Deployment name in Foundry (exact)
AZURE_OPENAI_MODEL=gpt-5.4-mini

# Optional (lower = less random looping; use "default" to omit)
AZURE_OPENAI_MAX_OUTPUT_TOKENS=300
AZURE_OPENAI_TEMPERATURE=0.2

# Project reference (for humans / other tools — not read by rollout_llm.py yet)
# AZURE_FOUNDRY_PROJECT_ENDPOINT=https://armaan-foundry.services.ai.azure.com/api/projects/multi-agent-collapse
